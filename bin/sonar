#!/usr/bin/env bash
# Sonar: a status line that stays short until something needs you.
#
#   sonar tmux <pane_id> <pane_path> <width>   tmux status-format line
#   sonar prompt <key> <dir> <width>           ANSI line above the bash prompt
#   sonar claude                               Claude Code statusLine (JSON on stdin)
#   sonar refresh <dir>                        background CI and port lookups
#   sonar agent wait|clear                     Claude Code hook (JSON on stdin)
#   sonar ports [--kill-strays]                every listener, with orphans flagged
#
# The render path only reads files. Anything slow (gh, ss) runs in `refresh`,
# which the render path starts in the background at most once per TTL, so a
# slow network call can never stall the bar.

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/sonar"
STATE="${XDG_RUNTIME_DIR:-/tmp}/sonar"
CI_TTL=60
PORT_TTL=15
mkdir -p "$CACHE" "$STATE/pane" "$STATE/agents" 2>/dev/null

# Sonar runs at every prompt, so the hot path avoids forks. The loadable stat
# builtin reads an mtime without starting a process.
enable -f /usr/lib/bash/stat stat 2>/dev/null

mtime_age() { # seconds since file $1 changed, or a large number if it is missing
  local -A st
  stat -A st "$1" 2>/dev/null || { echo 999999; return; }
  echo $(( EPOCHSECONDS - st[mtime] ))
}

# A cache file name for a path. Swapping / for % keeps it unique without hashing.
key_for() { echo "${1//\//%}"; }

# ---------- background refresh ----------

refresh() {
  local dir=$1 key root branch
  root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return
  key=${ key_for "$root"; }

  branch=$(git -C "$root" symbolic-ref --short -q HEAD)
  if [[ -n $branch ]] && command -v gh >/dev/null; then
    local out
    # An empty result means there is no run for this branch, so we show nothing.
    out=$(cd "$root" && timeout 10 gh run list -b "$branch" -L 1 \
            --json status,conclusion -q '.[0] | "\(.status) \(.conclusion)"' 2>/dev/null)
    printf '%s\n' "$out" > "$CACHE/$key.ci"
  fi

  # A port belongs to this repo when the listening process runs inside it. The
  # bar shows it only when it is fixed, that is outside the kernel ephemeral
  # range, or when .sonar names it. At most 3 ports show, then +N.
  local ports=() line pid port cwd lo hi
  ephemeral_range; lo=$EPH_LO hi=$EPH_HI
  sonar_names "$root"
  while read -r line; do
    port=${line%% *}; pid=${line#* }
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null) || continue
    [[ $cwd == "$root" || $cwd == "$root"/* ]] || continue
    [[ -n ${NAMES[$port]} ]] || (( port < lo || port > hi )) || continue
    ports+=("${NAMES[$port]}:$port")
  done < <(ss -Hltnp 2>/dev/null | sed -nE 's/^\S+\s+\S+\s+\S+\s+\S*:([0-9]+)\s.*pid=([0-9]+).*/\1 \2/p' | sort -un)
  (( ${#ports[@]} > 3 )) && ports=("${ports[@]:0:3}" "+$(( ${#ports[@]} - 3 ))")
  printf '%s\n' "${ports[*]}" > "$CACHE/$key.ports"
}

ephemeral_range() { # sets EPH_LO and EPH_HI from the kernel, or the Linux default
  EPH_LO=32768 EPH_HI=60999
  { read -r EPH_LO EPH_HI < /proc/sys/net/ipv4/ip_local_port_range; } 2>/dev/null
}

# A .sonar file in the repo names ports, one name=port pair per line. A repo
# can be a stranger's clone, so we only match the pattern and never source the file.
sonar_names() { # $1 repo root; fills the NAMES map from port to name
  local line
  declare -gA NAMES=()
  [[ -r $1/.sonar ]] || return
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^([A-Za-z0-9_-]+)=([0-9]+)$ ]] && NAMES[${BASH_REMATCH[2]}]=${BASH_REMATCH[1]}
  done < "$1/.sonar"
}

maybe_refresh() { # $1 dir, $2 cache key
  local lock="$CACHE/$2.lock"
  if (( ${ mtime_age "$CACHE/$2.ci"; } > CI_TTL || ${ mtime_age "$CACHE/$2.ports"; } > PORT_TTL )) \
     && (( ${ mtime_age "$lock"; } > CI_TTL )); then
    : > "$lock"
    ( refresh "$1" >/dev/null 2>&1 & )
  fi
}

# ---------- segment collection ----------
# Each segment is "side<TAB>priority", then one "width<TAB>styled text" pair
# per form, longest form first. When the line is too wide, render moves
# segments to shorter forms first and drops them only after that. Priority 1
# is never dropped. Higher numbers shorten and drop first.

SEGS=()
add() { local IFS=$'\t'; SEGS+=("$*"); } # side priority width text [width text]...

# Style helpers. tmux uses #[...] markup, Claude Code uses ANSI escapes.
# Colors are the Tokyo Night values from the Sonar pitch.
style() { # $1 name, $2 text
  local c
  case $1 in
    dim) c='#565f89' ;; blue) c='#7aa2f7' ;; cyan) c='#7dcfff' ;; green) c='#9ece6a' ;;
    amber) c='#e0af68' ;; red) c='#f7768e' ;; violet) c='#bb9af7' ;; orange) c='#ff9e64' ;;
  esac
  if [[ $MODE == tmux ]]; then
    case $1 in
      bold) printf '#[bold]%s#[nobold]' "$2" ;;
      danger) printf '#[bg=#f7768e,fg=#16161e,bold] %s #[bg=#16161e,fg=#c0caf5,nobold]' "$2" ;;
      *) printf '#[fg=%s]%s#[fg=#c0caf5]' "$c" "$2" ;;
    esac
  else
    case $1 in
      bold) printf '\e[1m%s\e[22m' "$2" ;;
      danger) printf '\e[48;2;247;118;142m\e[38;2;22;22;30m\e[1m %s \e[0m' "$2" ;;
      *) printf '\e[38;2;%d;%d;%dm%s\e[39m' "0x${c:1:2}" "0x${c:3:2}" "0x${c:5:2}" "$2" ;;
    esac
  fi
}

seg_danger() { # $1 AWS profile
  local ctx="" cfg=${KUBECONFIG:-$HOME/.kube/config}
  [[ -r ${cfg%%:*} ]] && ctx=$(sed -n 's/^current-context:[[:space:]]*//p' "${cfg%%:*}" | tr -d '"')
  local hit=""
  [[ $ctx == *prod* ]] && hit=$ctx
  [[ -z $hit && $1 == *prod* ]] && hit=$1
  [[ -n $hit ]] && add l 1 $(( ${#hit} + 4 )) "${ style danger "⚠ $hit"; }"
}

seg_remote() { # $1 SSH_CONNECTION, $2 host
  [[ -n $1 ]] && add l 1 $(( ${#2} + 2 )) "${ style violet "⇄ $2"; }"
}

# Inside a repo the path starts at the repo. It shortens from repo/sub/dir to
# repo/…/dir and then to repo. A linked worktree shows the main repo's name and ⧉. Its folder
# shows too, unless the folder is named after the branch, so the bar does not
# print the same words twice.
seg_repo_path() { # uses GIT_ROOT, GIT_COMMON, GIT_PREFIX and GIT_BRANCH
  local name=${GIT_ROOT##*/} mark="" folder="" rel=${GIT_PREFIX%/} head plain main forms=()
  if [[ $GIT_COMMON != "$GIT_ROOT/.git" ]]; then
    main=${GIT_COMMON%/}; main=${main%/.git}
    folder=$name; name=${main##*/}; name=${name%.git}; mark=" ⧉"
    [[ $folder == "$GIT_BRANCH" || $folder == "${GIT_BRANCH//\//-}" || $folder == "${GIT_BRANCH##*/}" ]] && folder=""
  fi
  head=${ style blue "${ style bold "$name"; }"; }
  [[ -n $mark ]] && head+=${ style dim "$mark"; }
  [[ -n $folder ]] && head+=${ style dim " $folder"; }
  plain="$name$mark${folder:+ $folder}"
  if [[ -n $rel ]]; then
    forms+=( $(( ${#plain} + 1 + ${#rel} )) "$head${ style dim "/$rel"; }" )
    local leaf=${rel##*/}
    [[ $rel == */* ]] && forms+=( $(( ${#plain} + 3 + ${#leaf} )) "$head${ style dim "/…/$leaf"; }" )
  fi
  add l 1 "${forms[@]}" "${#plain}" "$head"
}

seg_path() { # $1 dir, $2 repo root or empty
  [[ -n $2 ]] && { seg_repo_path; return; }
  local d=$1 home=$HOME rel parent leaf out=""
  [[ $d == "$home" || $d == "$home"/* ]] && d="~${d#"$home"}"
  leaf=${d##*/}; parent=${d%/*}
  [[ $d == "~" || $d == / ]] && { leaf=$d; parent=""; }
  # Shorten each parent component to its first character.
  local IFS=/ part
  for part in $parent; do
    [[ -z $part ]] && continue
    # Keep the dot of a hidden directory, so .config reads as .c and not as a bare dot.
    [[ $part == .* ]] && out+="${part:0:2}/" || out+="${part:0:1}/"
  done
  [[ $parent == /* ]] && out="/$out"
  [[ -z $parent && $d == /* && $d != / ]] && out="/"
  local w=$(( ${#out} + ${#leaf} ))
  add l 1 "$w" "${ style dim "$out"; }${ style blue "$leaf"; }"
}

# The path segment needs the branch name, so we read git status before any
# segment is added and keep the results in GIT_* globals.
git_read() { # $1 dir; sets GIT_BRANCH, GIT_DIRTY and the GIT_* counts
  local line branch="" ahead=0 behind=0 staged=0 modified=0 untracked=0 conflicted=0
  GIT_DIRTY=0
  while IFS= read -r line; do
    case $line in
      '# branch.head '*) branch=${line#\# branch.head } ;;
      '# branch.oid '*) oid=${line#\# branch.oid } ;;
      '# branch.ab '*) read -r _ _ ahead behind <<<"$line"; ahead=${ahead#+}; behind=${behind#-} ;;
      '1 '*|'2 '*)
        [[ ${line:2:1} != . ]] && ((staged++))
        [[ ${line:3:1} != . ]] && ((modified++)) ;;
      'u '*) ((conflicted++)) ;;
      '? '*) ((untracked++)) ;;
    esac
  done < <(git -C "$1" status --porcelain=v2 -b 2>/dev/null)
  [[ $branch == "(detached)" ]] && branch=${oid:0:7}
  (( staged + modified + untracked + conflicted )) && GIT_DIRTY=1
  GIT_BRANCH=$branch GIT_AHEAD=$ahead GIT_BEHIND=$behind GIT_STAGED=$staged
  GIT_MODIFIED=$modified GIT_UNTRACKED=$untracked GIT_CONFLICTED=$conflicted
}

# Shorter forms of a branch name, longest first, in BRANCH_FORMS. A long name
# loses its middle first. Then it keeps the type and the ticket number, or the
# type and the last word. We keep a form only when it is shorter than the one
# before it, so a short name never turns into a bare ellipsis.
branch_forms() { # $1 branch
  local b=$1 prev=$1 h t type rest f
  BRANCH_FORMS=()
  if (( ${#b} > 28 )); then
    h=${b:0:14}; h=${h%[-_/]}; t=${b: -13}; t=${t#[-_/]}
    BRANCH_FORMS+=("$h…$t"); prev="$h…$t"
  fi
  [[ $b == */* ]] || return
  type=${b%%/*}; rest=${b#*/}
  # A ticket number is a group of digits that stands alone between separators,
  # so "aromatica-017-add" has one and "oauth2-login" does not.
  if [[ $rest =~ (^|[-_])([0-9]+)([-_]|$) ]]; then f="$type/${BASH_REMATCH[2]}…"
  else f="$type/…${rest##*[-_]}"; fi
  (( ${#f} < ${#prev} )) && BRANCH_FORMS+=("$f")
}

seg_git() { # uses the GIT_* values from git_read
  local tail="" tw=0 b forms=()
  (( GIT_AHEAD ))      && { tail+=" ${ style green "⇡$GIT_AHEAD"; }";       tw=$(( tw + 2 + ${#GIT_AHEAD} )); }
  (( GIT_BEHIND ))     && { tail+=" ${ style red "⇣$GIT_BEHIND"; }";        tw=$(( tw + 2 + ${#GIT_BEHIND} )); }
  (( GIT_CONFLICTED )) && { tail+=" ${ style red "!$GIT_CONFLICTED"; }";    tw=$(( tw + 2 + ${#GIT_CONFLICTED} )); }
  (( GIT_STAGED ))     && { tail+=" ${ style green "+$GIT_STAGED"; }";      tw=$(( tw + 2 + ${#GIT_STAGED} )); }
  (( GIT_MODIFIED ))   && { tail+=" ${ style amber "●$GIT_MODIFIED"; }";    tw=$(( tw + 2 + ${#GIT_MODIFIED} )); }
  (( GIT_UNTRACKED ))  && { tail+=" ${ style dim "?$GIT_UNTRACKED"; }";     tw=$(( tw + 2 + ${#GIT_UNTRACKED} )); }
  branch_forms "$GIT_BRANCH"
  for b in "$GIT_BRANCH" "${BRANCH_FORMS[@]}"; do
    forms+=( $(( ${#b} + 2 + tw )) "${ style cyan "⎇ $b"; }$tail" )
  done
  add l 1 "${forms[@]}"
}

seg_drift() { # $1 repo root. Only shown while the tree is dirty.
  (( GIT_DIRTY )) || return
  local ct age mins glyph col txt
  ct=$(git -C "$1" log -1 --format=%ct 2>/dev/null) || return
  [[ -n $ct ]] || return
  age=$(( EPOCHSECONDS - ct )); mins=$(( age / 60 ))
  if   (( mins < 30 ));  then glyph=◔
  elif (( mins < 60 ));  then glyph=◑
  elif (( mins < 180 )); then glyph=◕
  else glyph=●; fi
  (( mins >= 90 )) && col=amber || col=dim
  if (( mins < 60 )); then txt="${mins}m"
  elif (( mins < 1440 )); then printf -v txt '%dh%02d' $(( mins / 60 )) $(( mins % 60 ))
  else txt="$(( mins / 1440 ))d"; fi
  # In a narrow pane the dial alone still says how old the work is.
  add l 4 $(( ${#txt} + 2 )) "${ style "$col" "$glyph $txt"; }" 1 "${ style "$col" "$glyph"; }"
}

seg_last() { # $1 exit status, $2 duration in ms
  local st=$1 ms=${2:-0} dur="" txt
  [[ -z $st ]] && return
  (( ms >= 5000 )) && printf -v dur '%d.%ds' $(( ms / 1000 )) $(( ms % 1000 / 100 ))
  if (( st != 0 )); then
    txt="✗ $st${dur:+ · $dur}"
    add r 1 "${#txt}" "${ style red "$txt"; }"
  elif [[ -n $dur ]]; then
    txt="✓ $dur"
    add r 1 "${#txt}" "${ style dim "$txt"; }"
  fi
}

seg_ci() { # $1 cache key
  local status conclusion
  [[ -r $CACHE/$1.ci ]] || return
  read -r status conclusion < "$CACHE/$1.ci"
  [[ -z $status ]] && return
  if [[ $status != completed ]]; then add r 2 4 "${ style amber "ci ◌"; }"
  elif [[ $conclusion == success ]]; then add r 2 4 "${ style green "ci ✓"; }"
  elif [[ $conclusion == skipped || $conclusion == cancelled ]]; then return
  else add r 2 4 "${ style red "ci ✗"; }"; fi
}

seg_toolchain() { # $1 repo root, $2 PATH to resolve node against
  local want="" have="" f node
  for f in "$1/.tool-versions" "$1/mise.toml" "$1/.mise.toml" "$1/.nvmrc" "$1/.node-version"; do
    [[ -r $f ]] || continue
    case ${f##*/} in
      .tool-versions) want=$(sed -nE 's/^nodejs?[[:space:]]+([^[:space:]]+).*/\1/p' "$f") ;;
      mise.toml|.mise.toml) want=$(sed -nE 's/^node[[:space:]]*=[[:space:]]*"?([^"[:space:]]+)"?.*/\1/p' "$f") ;;
      *) want=$(head -1 "$f") ;;
    esac
    [[ -n $want ]] && break
  done
  want=${want#v}
  [[ $want =~ ^[0-9] ]] || return   # "lts/*", "latest" and similar aliases are not pinned
  node=${ PATH=$2 command -v node; } || return
  # mise installs carry the version in the path. Anything else we ask once and cache.
  if [[ $(readlink -f "$node") =~ /installs/node/([0-9][^/]*)/ ]]; then
    have=${BASH_REMATCH[1]}
  else
    local c="$CACHE/node-$(key_for "$(readlink -f "$node")")"
    [[ -s $c ]] || { "$node" --version 2>/dev/null | tr -d v > "$c"; }
    have=$(<"$c")
  fi
  [[ -z $have ]] && return
  # Compare only as many components as the pin gives: "20" matches 20.11.1.
  local n=${want//[^.]/}; n=$(( ${#n} + 1 ))
  local have_cut; have_cut=$(cut -d. -f1-"$n" <<<"$have")
  if [[ $have_cut != "$want" ]]; then
    local txt="node ${have%%.*}≠${want%%.*}"
    [[ ${have%%.*} == "${want%%.*}" ]] && txt="node $have≠$want"
    add r 2 "${#txt}" "${ style orange "$txt"; }"
  fi
}

seg_agents() {
  local n=0 f
  for f in "$STATE/agents"/*; do
    [[ -e $f ]] || continue
    # A session that crashed without clearing its file stops counting after 12 hours.
    (( ${ mtime_age "$f"; } < 43200 )) && ((n++))
  done
  (( n )) && add r 2 $(( ${#n} + 10 )) "${ style violet "✦ $n waiting"; }" \
                   $(( ${#n} + 1 )) "${ style violet "✦$n"; }"
}

seg_ports() { # $1 cache key
  local p
  [[ -r $CACHE/$1.ports ]] || return
  p=$(<"$CACHE/$1.ports")
  [[ -n $p ]] && add r 3 "${#p}" "${ style green "$p"; }"
}

seg_jobs() { # $1 job count
  (( ${1:-0} > 0 )) && add r 3 $(( ${#1} + 1 )) "${ style dim "⚙$1"; }"
}

# ---------- layout ----------

render() { # $1 width
  local width=$1 sep_w=3 i k
  local -a keep side pri lvl nf f
  local -A fw ft # width and text of form k of segment i, keyed "i,k"
  for i in "${!SEGS[@]}"; do
    IFS=$'\t' read -ra f <<<"${SEGS[i]}"
    side[i]=${f[0]}; pri[i]=${f[1]}; keep[i]=1; lvl[i]=0
    nf[i]=$(( (${#f[@]} - 2) / 2 ))
    for (( k = 0; k < nf[i]; k++ )); do
      fw[$i,$k]=${f[2 + 2 * k]}; ft[$i,$k]=${f[3 + 2 * k]}
    done
  done
  total() {
    local t=4 nl=0 nr=0 j
    for j in "${!SEGS[@]}"; do
      (( keep[j] )) || continue
      t=$(( t + fw[$j,${lvl[j]}] ))
      [[ ${side[j]} == l ]] && ((nl++)) || ((nr++))
    done
    (( nl > 1 )) && t=$(( t + (nl - 1) * sep_w ))
    (( nr > 1 )) && t=$(( t + (nr - 1) * sep_w ))
    echo "$t"
  }
  # Shorten first, one step at a time, starting with the lowest-priority
  # segment that still has a shorter form. This is the order the pitch mockup uses.
  while (( ${ total; } > width )); do
    local pick=-1 pp=0
    for i in "${!SEGS[@]}"; do
      (( keep[i] && lvl[i] < nf[i] - 1 && pri[i] > pp )) && { pick=$i; pp=${pri[i]}; }
    done
    (( pick < 0 )) && break
    lvl[pick]=$(( lvl[pick] + 1 ))
  done
  # Then drop the lowest-priority segment until the line fits. Priority 1 always stays.
  while (( ${ total; } > width )); do
    local worst=-1 wp=1
    for i in "${!SEGS[@]}"; do
      (( keep[i] && pri[i] > wp )) && { worst=$i; wp=${pri[i]}; }
    done
    (( worst < 0 )) && break
    keep[worst]=0
  done

  local sep; sep=${ style dim " · "; }
  local left="" right="" lw=0 rw=0
  for i in "${!SEGS[@]}"; do
    (( keep[i] )) || continue
    k=$i,${lvl[i]}
    if [[ ${side[i]} == l ]]; then
      [[ -n $left ]] && { left+=$sep; lw=$(( lw + sep_w )); }
      left+=${ft[$k]}; lw=$(( lw + fw[$k] ))
    else
      [[ -n $right ]] && { right+=$sep; rw=$(( rw + sep_w )); }
      right+=${ft[$k]}; rw=$(( rw + fw[$k] ))
    fi
  done

  if [[ $MODE == tmux ]]; then
    printf '#[bg=#16161e,fg=#c0caf5,fill=#16161e]  %s#[align=right]%s  ' "$left" "$right"
  else
    # Claude Code pads nothing for us, so we right-align the second half by hand.
    local gap=$(( width - lw - rw - 4 )); (( gap < 2 )) && gap=2
    printf '  %s%*s%s\n' "$left" "$gap" '' "$right"
  fi
}

collect() { # $1 dir, $2 status, $3 ms, $4 jobs, $5 aws, $6 ssh, $7 PATH
  local dir=$1 key
  GIT_ROOT="" GIT_COMMON="" GIT_PREFIX=""
  # One git call gives the root, the shared .git of a worktree, and the subdirectory.
  # We ask for absolute paths because in a main checkout --git-common-dir is otherwise just ".git".
  { read -r GIT_ROOT; read -r GIT_COMMON; read -r GIT_PREFIX; } < <(git -C "$dir" rev-parse \
      --path-format=absolute --show-toplevel --git-common-dir --show-prefix 2>/dev/null)
  [[ -n $GIT_ROOT ]] && git_read "$dir"
  seg_danger "$5"
  seg_remote "$6" "${HOSTNAME%%.*}"
  seg_path "$dir" "$GIT_ROOT"
  if [[ -n $GIT_ROOT ]]; then
    key=${ key_for "$GIT_ROOT"; }
    seg_git
    seg_drift "$GIT_ROOT"
  fi
  seg_last "$2" "$3"
  if [[ -n $GIT_ROOT ]]; then
    seg_ci "$key"
    seg_toolchain "$GIT_ROOT" "$7"
  fi
  seg_agents
  [[ -n $GIT_ROOT ]] && seg_ports "$key"
  seg_jobs "$4"
  [[ -n $GIT_ROOT ]] && maybe_refresh "$GIT_ROOT" "$key"
}

# ---------- sonar ports ----------
# Lists every listener on the machine, not only the ones on the bar. Nothing
# here runs on the render path, so it can afford to read /proc for each process.

proc_info() { # $1 pid; sets P_PPID, P_START (clock ticks since boot), P_CMD, P_NAME and P_CWD
  local s a args=()
  P_PPID="" P_START="" P_CMD="" P_NAME="-" P_CWD=""
  { s=$(<"/proc/$1/stat"); } 2>/dev/null || return 1
  # The command name in field 2 can hold spaces, so we split after its closing paren.
  read -ra a <<<"${s##*) }"
  P_PPID=${a[1]} P_START=${a[19]}
  mapfile -d '' args < "/proc/$1/cmdline" 2>/dev/null
  P_CMD="${args[*]}"
  P_CWD=$(readlink "/proc/$1/cwd" 2>/dev/null)
  { P_NAME=$(<"/proc/$1/comm"); } 2>/dev/null
  # For a script run by an interpreter, the script name says more than "node".
  case ${args[0]##*/} in
    node|bun|deno|python*|ruby|perl)
      local x
      for x in "${args[@]:1}"; do
        [[ $x == -* ]] && continue
        x=${x##*/}; P_NAME=${x%.*}; break
      done ;;
  esac
}

# An orphan is a listener whose parent is gone, so PID 1 or the systemd user
# manager, which adopts orphaned user processes, is now its parent.
is_orphan() { # $1 parent pid
  [[ $1 == 1 ]] && return 0
  local args=()
  mapfile -d '' args < "/proc/$1/cmdline" 2>/dev/null
  [[ ${args[0]##*/} == systemd && " ${args[*]:1} " == *" --user "* ]]
}

fmt_age() { # $1 seconds
  local m=$(( $1 / 60 ))
  if (( m < 60 )); then echo "${m}m"
  elif (( m < 1440 )); then printf '%dh%02d\n' $(( m / 60 )) $(( m % 60 ))
  else echo "$(( m / 1440 ))d"; fi
}

# Asks before each kill and defaults to No, because a detached server that
# someone wants, such as a viewer started on purpose, also looks like an orphan.
# The answer comes from stdin, so the caller connects it to the terminal.
confirm_kill() { # $1 pid, $2 start ticks seen in the listing, $3 port, $4 age, $5 cwd, $6 command
  local ans=""
  printf 'kill %s (:%s, up %s, in %s)?\n  %s\n[y/N] ' "$1" "$3" "$4" "$5" "$6"
  read -r ans || ans=""
  [[ $ans == [yY] ]] || { echo "kept $1"; return; }
  # A PID can be reused after exit. The start time tells the old process from a new one.
  proc_info "$1" && [[ $P_START == "$2" ]] || { echo "$1 already gone"; return; }
  kill -TERM "$1" && echo "sent SIGTERM to $1"
}

ports_cmd() { # $1 dir, $2 --kill-strays or empty
  local root lo hi up tck state rq sq local_ peer rest port pid i j
  local -a rows_port rows_pid
  local -A seen name start ppid cmd cwd age
  root=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)
  ephemeral_range; lo=$EPH_LO hi=$EPH_HI
  declare -gA NAMES=(); [[ -n $root ]] && sonar_names "$root"
  read -r up _ < /proc/uptime; up=${up%.*}; tck=$(getconf CLK_TCK)
  while read -r state rq sq local_ peer rest; do
    port=${local_##*:}; pid=-
    [[ $rest =~ pid=([0-9]+) ]] && pid=${BASH_REMATCH[1]}
    [[ -n ${seen[$port,$pid]} ]] && continue # one row per port and PID, not per address
    seen[$port,$pid]=1
    rows_port+=("$port"); rows_pid+=("$pid")
    [[ $pid == - || -n ${cmd[$pid]+x} ]] && continue
    proc_info "$pid" || continue
    name[$pid]=$P_NAME start[$pid]=$P_START ppid[$pid]=$P_PPID cmd[$pid]=$P_CMD cwd[$pid]=$P_CWD
    age[$pid]=${ fmt_age $(( up - P_START / tck )); }
  done < <(ss -Hltnp 2>/dev/null)

  local -a orphans=()
  printf '%-7s %-8s %-12s %-5s %-4s %s\n' PORT PID NAME AGE BAR NOTE
  for i in ${ for j in "${!rows_port[@]}"; do echo "${rows_port[j]} $j"; done | sort -n | cut -d' ' -f2; }; do
    port=${rows_port[i]} pid=${rows_pid[i]}
    local nm=${NAMES[$port]:-${name[$pid]:--}} bar=no note="" p
    if [[ -n $root && $pid != - && ( ${cwd[$pid]} == "$root" || ${cwd[$pid]} == "$root"/* ) ]] \
       && { [[ -n ${NAMES[$port]} ]] || (( port < lo || port > hi )); }; then bar=yes; fi
    if [[ $pid != - && -n ${cmd[$pid]+x} ]]; then
      p=${ppid[$pid]}
      if [[ -n ${cmd[$p]+x} ]]; then note="child of ${name[$p]} $p"
      elif is_orphan "$p"; then note=orphan; orphans+=("$pid")
      fi
      # A duplicate runs the same command in the same folder as another listener.
      for j in "${!cmd[@]}"; do
        [[ $j != "$pid" && ${cmd[$j]} == "${cmd[$pid]}" && ${cwd[$j]} == "${cwd[$pid]}" ]] && { note+="${note:+, }duplicate of $j"; break; }
      done
    fi
    printf '%-7s %-8s %-12s %-5s %-4s %s\n' ":$port" "$pid" "$nm" "${age[$pid]:--}" "$bar" "$note"
  done

  [[ $2 == --kill-strays ]] || return 0
  (( ${#orphans[@]} )) || { echo "no orphans"; return 0; }
  for pid in ${ printf '%s\n' "${orphans[@]}" | sort -un; }; do
    port=""
    for i in "${!rows_pid[@]}"; do [[ ${rows_pid[i]} == "$pid" ]] && port+="${port:+,}${rows_port[i]}"; done
    confirm_kill "$pid" "${start[$pid]}" "$port" "${age[$pid]}" "${cwd[$pid]}" "${cmd[$pid]}" < /dev/tty
  done
}

# Tests source this file to call its functions, so the dispatch runs only
# when sonar runs as a program.
[[ ${BASH_SOURCE[0]} != "$0" ]] && return 0

case $1 in
  ports)
    ports_cmd "$PWD" "$2"
    ;;
  tmux|prompt)
    # tmux mode draws the tmux status row. Prompt mode prints an ANSI line
    # that the bash hook shows above the prompt when there is no tmux.
    MODE=$1; [[ $MODE == prompt ]] && MODE=claude
    pane=${2#%}; dir=$3; width=${4:-140}
    st="" ms="" jobs=0 aws="" ssh="" path=$PATH
    # The bash hook writes one file per pane: status, ms, jobs, AWS profile, SSH, PATH.
    if [[ -r $STATE/pane/$pane ]]; then
      { read -r st; read -r ms; read -r jobs; read -r aws; read -r ssh; read -r path; } < "$STATE/pane/$pane"
    fi
    collect "$dir" "$st" "$ms" "$jobs" "$aws" "$ssh" "$path"
    render "$width"
    ;;
  claude)
    MODE=claude
    dir=$(jq -r '.workspace.current_dir // .cwd // empty' 2>/dev/null)
    [[ -d $dir ]] || dir=$PWD
    width=${COLUMNS:-$({ stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2)}
    collect "$dir" "" "" 0 "$AWS_PROFILE" "$SSH_CONNECTION" "$PATH"
    render "${width:-140}"
    ;;
  refresh)
    refresh "${2:-$PWD}"
    ;;
  agent)
    sid=$(jq -r '.session_id // empty' 2>/dev/null)
    [[ -n $sid ]] || exit 0
    case $2 in
      wait) : > "$STATE/agents/$sid" ;;
      clear) rm -f "$STATE/agents/$sid" ;;
    esac
    ;;
  *)
    echo "usage: sonar tmux <pane_id> <dir> <width> | claude | refresh <dir> | agent wait|clear | ports [--kill-strays]" >&2
    exit 2
    ;;
esac
